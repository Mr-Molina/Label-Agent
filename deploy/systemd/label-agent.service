[Unit]
Description=Label-Agent Autonomous Voice & Inventory Label Appliance
Documentation=https://github.com/Mr-Molina/Label-Agent
After=network-online.target cups.service ntpsec.service
Wants=network-online.target

[Service]
Type=simple
User=console-admin
Group=console-admin
SupplementaryGroups=lp audio
EnvironmentFile=-/etc/label-agent/label-agent.env

ExecStart=/usr/local/bin/label-agent --daemon --listen 127.0.0.1:8090 --spool-dir /tmp/label-agent-spool
Restart=on-failure
RestartSec=5s

# Resource limits targeting Libre Computer AML-S905X-CC "Le Potato" (2GB RAM)
MemoryHigh=192M
MemoryMax=256M
CPUQuota=350%

# Sandboxing and tmpfs Spool Isolation
# PrivateTmp=no enables sharing the RAM-backed tmpfs mount at /tmp
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
DeviceAllow=/dev/usb/lp0 rw
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
LimitNOFILE=65536

# Environment configuration
Environment=RUST_LOG=info,label_agent=debug
Environment=TMPDIR=/tmp

[Install]
WantedBy=multi-user.target
